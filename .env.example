# Safe local-development defaults. Never put real credentials in this file.
NODE_ENV=development
APP_PORT=8080
FE_DOMAIN=http://localhost:3000

POSTGRES_USER=student_marketplace
POSTGRES_PASSWORD=student_marketplace_dev_only
POSTGRES_DB=student_marketplace
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRED=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRED=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
BROWSER_REDIRECT_URI=http://localhost:3000/login/success

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=12345678
SEED_ADMIN_PHONE=1234567890

# Chat image storage (Cloudflare R2, bucket private — không dùng public URL cho ảnh chat)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<accountId>.r2.cloudflarestorage.com
# Giới hạn dung lượng mỗi file upload (MB, số dương; default 5)
MAX_UPLOAD_SIZE_MB=5
# TTL presigned PUT (giây, int 1..604800; default 300)
SIGNED_URL_EXPIRES_SEC=300
# TTL presigned GET ảnh chat private (giây, int 1..604800; default 900)
SIGNED_GET_URL_EXPIRES_SEC=900
# Automatic schema changes are opt-in for development/test only.
POSTGRES_SCHEMA=public
POSTGRES_SYNCHRONIZE=false

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_PREVIEW=false
MAIL_FROM=
# Separate random secret, at least 32 bytes. Do not reuse JWT secrets.
PASSWORD_RESET_SECRET=8ae985029735122711fddfa597c051db05943a0cd064ef8dad5c0c8289593327

# VNPAY sandbox — backend payment module configuration.
# The FE return page and BE IPN route below are implemented.
# Docs: https://sandbox.vnpayment.vn/apis/docs/thanh-toan-pay/pay.html
# Register sandbox credentials: https://sandbox.vnpayment.vn/devreg/
# Copy your own sandbox credentials into .env. Keep the hash secret backend-only.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Server-to-server transaction query/refund endpoint (for reconciliation).
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_VERSION=2.1.0
VNPAY_LOCALE=vn
# App-defined payment window in minutes; use it to generate vnp_ExpireDate.
VNPAY_PAYMENT_TIMEOUT_MINUTES=15
# Browser return page on FE; this page alone must not grant the service.
VNPAY_RETURN_URL=http://localhost:3000/payments/vnpay/return
# BE IPN route. Replace with your public HTTPS backend/tunnel URL.
# Configure the same IPN URL with VNPAY; an env value alone does not register it.
# This is not a vnp_IpnUrl parameter in the payment redirect request.
VNPAY_IPN_URL=https://your-public-backend.example.com/api/v1/payments/vnpay/ipn

VNPAY_BOOST_24H_PRICE=10000
VNPAY_BOOST_48H_PRICE=18000
VNPAY_BOOST_72H_PRICE=24000

# Server IP used for querydr; set the deployed server IP when available.
VNPAY_QUERY_IP=127.0.0.1
